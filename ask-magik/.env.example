# Ask MAGIK - Environment Configuration
# Phase 2: Local RAG + Llama Text-to-SQL Engine

# Database Configuration
DATABASE_URL=sqlite:///./data/skyline.db
ENVIRONMENT=development
APP_NAME=Ask MAGIK
PHASE=2

# Local LLM / Ollama Configuration
OLLAMA_BASE_URL=http://localhost:11434
# If llama3 is not pulled, phi3:latest or gemma3:4b can be set here
OLLAMA_MODEL=phi3:latest

# Local Embeddings & Vector Database
EMBEDDING_MODEL=all-MiniLM-L6-v2
CHROMA_PATH=backend/rag/chroma_db
RAG_TOP_K=8

# Query Safeguards
SQL_MAX_ROWS=500
DATA_REFRESH_NOTE=Daily

# Fast response mode (default: off — uses golden-example SQL + instant answers)
# Set to true only if you want full local LLM generation (slower, more flexible)
USE_LLM_SQL=false
USE_LLM_EXPLANATION=false
LLM_TIMEOUT_SECONDS=30
