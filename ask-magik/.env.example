# Ask MAGIK — Environment Configuration
# ============================================================
# LOCAL DEVELOPMENT  (copy to .env and adjust)
# ============================================================

# ── App ─────────────────────────────────────────────────────
APP_NAME=Ask MAGIK
PHASE=2
ENVIRONMENT=development

# ── Database ────────────────────────────────────────────────
# Relative path works locally (resolved to ask-magik/data/skyline.db).
# On Railway the volume is mounted at /app/data — set the absolute path:
#   DATABASE_URL=sqlite:////app/data/skyline.db
DATABASE_URL=sqlite:///./data/skyline.db

# ── Local LLM / Ollama ──────────────────────────────────────
# Production on Railway uses deterministic golden-SQL mode (USE_LLM_SQL=false),
# so Ollama is NOT required in the Railway environment.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=phi3:latest

# ── Embeddings & Vector Store ───────────────────────────────
EMBEDDING_MODEL=all-MiniLM-L6-v2
CHROMA_PATH=backend/rag/chroma_db
RAG_TOP_K=8

# ── Query Safeguards ────────────────────────────────────────
SQL_MAX_ROWS=500
DATA_REFRESH_NOTE=Daily

# ── LLM Mode ─────────────────────────────────────────────────
# Keep both false for fast deterministic mode (no Ollama needed).
USE_LLM_SQL=false
USE_LLM_EXPLANATION=false
LLM_TIMEOUT_SECONDS=30

# ============================================================
# PRODUCTION — Railway backend environment variables
# Set these in the Railway dashboard → Variables tab
# ============================================================
#
# DATABASE_URL=sqlite:////app/data/skyline.db
#
# ALLOWED_ORIGINS=https://ask-magik-insightx.vercel.app,https://ask-magik-production.up.railway.app
# (Accepts a comma-separated list. The backend ALSO allows all *.vercel.app
#  subdomains via regex, so Vercel preview deployments work automatically.)
#
# ENVIRONMENT=production
# DATA_REFRESH_NOTE=UPDATED TODAY
# USE_LLM_SQL=false
# USE_LLM_EXPLANATION=false
#
# ── Frontend (Vercel) ─────────────────────────────────────
# The frontend is plain HTML/CSS/JS — no build-time environment variables.
# All /api/* calls are routed to Railway via vercel.json rewrites.
# No VITE_ or NEXT_PUBLIC_ variables are required.
# The Railway backend URL is configured in: ask-magik/frontend/vercel.json
